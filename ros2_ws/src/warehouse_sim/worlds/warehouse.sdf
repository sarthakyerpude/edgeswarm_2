<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- =====================================================================
         PHYSICS
         1 kHz update rate / 1 ms step is a stable, common default for
         Gazebo Harmonic diff-drive robots at this scale.
         ===================================================================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- =====================================================================
         REQUIRED SYSTEM PLUGINS
         physics        - steps the world
         sensors        - required for the robot's lidar to produce data
         scene_broadcaster - required for GUI / rendering clients
         user_commands  - required to move/spawn things at runtime (e.g. the
                          movable box) via `gz service`/the GUI
         ===================================================================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- =====================================================================
         LIGHTING
         One outdoor "sun" for shadows/orientation plus two indoor point
         lights so the aisles aren't rendered pitch black.
         ===================================================================== -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light type="point" name="warehouse_light_north">
      <pose>0 3 3.2 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="warehouse_light_south">
      <pose>0 -3 3.2 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- =====================================================================
         WAREHOUSE STRUCTURE
         One static model holding the floor, the four outer walls and three
         rack rows. Interior clear footprint is 12 m (X) x 10 m (Y), centred
         on the world origin.

         Layout along Y (north = +Y, south = -Y). R7 equal aisles: every
         aisle and the N-S spine is 1.6 m (two 0.32 m robots abreast):
           5.0  |  north wall face
                   NORTH AISLE - width 1.6 m (5.0 -> 3.4)
           3.4  |  Row 1 north face
           3.1  ..  Row 1 (rack row, depth 0.6 m)
           2.8  |  Row 1 south face
                   AISLE_A - width 1.6 m (2.8 -> 1.2)
           1.2  |  Row 2 north face
           0.9  ..  Row 2 (rack row, depth 0.6 m)
           0.6  |  Row 2 south face
                   AISLE_B - width 1.6 m (0.6 -> -1.0)
          -1.0  |  Row 3 north face
          -1.3  ..  Row 3 (rack row, depth 0.6 m)
          -1.6  |  Row 3 south face
                   SOUTH AREA 3.4 m (drop-offs y=-2.8, spawns y=-4.0)
          -5.0  |  south wall face

         Every rack row is split into a west and an east 5.0 m segment
         (X in [-5.8, -0.8] and [0.8, 5.8]), leaving a 1.6 m north-south
         spine at X in [-0.8, 0.8]; the 0.2 m end gaps to the side walls
         are closed by the wall_endcap_* links. The spine crossing AISLE_A is the marked
         INTERSECTION below.
         ===================================================================== -->
    <model name="warehouse_structure">
      <static>true</static>

      <link name="floor">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>12.3 10.3 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12.3 10.3 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_north">
        <pose>0 5.075 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.3 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_south">
        <pose>0 -5.075 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.3 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>6.075 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 10.3 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.3 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-6.075 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 10.3 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.3 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Row 1 (north rack), Y center 3.1, depth 0.6, height 1.6, length 5.0 -->
      <link name="rack_row1_west">
        <pose>-3.3 3.1 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="rack_row1_east">
        <pose>3.3 3.1 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Row 2 (middle rack), Y center 0.9 -->
      <link name="rack_row2_west">
        <pose>-3.3 0.9 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="rack_row2_east">
        <pose>3.3 0.9 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Row 3 (south rack), Y center -1.3 -->
      <link name="rack_row3_west">
        <pose>-3.3 -1.3 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="rack_row3_east">
        <pose>3.3 -1.3 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Rack-end caps (R7): close the 0.2 m rack-to-side-wall gaps
           (x in [-6,-5.8] / [5.8,6]) so no planner routes through them. -->
      <link name="wall_endcap_row1_west">
        <pose>-5.9 3.1 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_endcap_row1_east">
        <pose>5.9 3.1 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_endcap_row2_west">
        <pose>-5.9 0.9 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_endcap_row2_east">
        <pose>5.9 0.9 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_endcap_row3_west">
        <pose>-5.9 -1.3 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_endcap_row3_east">
        <pose>5.9 -1.3 0.8 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- =====================================================================
         INTERSECTION MARKER (visual only, no collision)
         Flags the zone where the north-south spine (X in [-0.8, 0.8])
         crosses AISLE_A (1.6 m, Y in [1.2, 2.8]). A robot travelling along AISLE_A and a robot travelling
         along the cross corridor both pass through this rectangle.
         ===================================================================== -->
    <model name="intersection_marker">
      <static>true</static>
      <link name="marker">
        <pose>0 2.0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.6 0.05 0.6</ambient>
            <diffuse>0.95 0.65 0.05 0.6</diffuse>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         ROBOT SPAWN POSITIONS (visual reference markers only)
         Flat yellow discs marking the three positions the fleet is expected
         to spawn from, in the south corridor. single_amr.launch.py spawns
         one robot at spawn_1 by default; spawn_2/spawn_3 are laid out here
         for a future multi-robot launch file.
         spawn_1: (-3.0, -4.0)   spawn_2: (0.0, -4.0)   spawn_3: (3.0, -4.0)
         ===================================================================== -->
    <model name="spawn_marker_1">
      <static>true</static>
      <link name="marker">
        <pose>-3.0 -4.0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>0.95 0.95 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="spawn_marker_2">
      <static>true</static>
      <link name="marker">
        <pose>0.0 -4.0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>0.95 0.95 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="spawn_marker_3">
      <static>true</static>
      <link name="marker">
        <pose>3.0 -4.0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>0.95 0.95 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         PICKUP MARKERS (green, visual only) - staged near the racks
         ===================================================================== -->
    <model name="pickup_1">
      <static>true</static>
      <link name="marker">
        <pose>-3.45 3.85 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.15 0.9 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pickup_2">
      <static>true</static>
      <link name="marker">
        <pose>3.45 3.85 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.15 0.9 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pickup_3">
      <static>true</static>
      <link name="marker">
        <pose>-3.45 2.45 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.15 0.9 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         DROP-OFF MARKERS (blue, visual only) - south corridor staging area
         ===================================================================== -->
    <model name="dropoff_1">
      <static>true</static>
      <link name="marker">
        <pose>-3.0 -2.8 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.15 0.35 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="dropoff_2">
      <static>true</static>
      <link name="marker">
        <pose>0.0 -2.8 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.15 0.35 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="dropoff_3">
      <static>true</static>
      <link name="marker">
        <pose>3.0 -2.8 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.15 0.35 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         MOVABLE BOX
         NOT static - has mass/inertia so it can be pushed or teleported
         (e.g. `gz service -s /world/warehouse/set_pose ...`) into an aisle
         later to test blocked-aisle replanning. Parked out of the way in
         the SE corner of the south corridor for now.
         ===================================================================== -->
    <model name="movable_box">
      <pose>5.3 -4.5 0.2 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1333</ixx>
            <iyy>0.1333</iyy>
            <izz>0.1333</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>0.7</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0.05 1</ambient>
            <diffuse>0.85 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

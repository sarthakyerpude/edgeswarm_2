<?xml version="1.0"?>
<?xml version="1.0"?>
<model>
  <name>amr_robot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>EdgeSwarm team</name>
    <email>xyz@gmail.com</email>
  </author>

  <description>
    Lightweight differential-drive AMR placeholder for the EdgeSwarm warehouse
    simulation. Basic-shape chassis, two driven wheels, one passive caster,
    and a single lidar. Spawned by warehouse_sim/launch/single_amr.launch.py.
    The entity name (and therefore all its topic names) is set at spawn time
    via `-name`, so this one model file serves robot_1, robot_2, robot_3, etc.
  </description>
</model>

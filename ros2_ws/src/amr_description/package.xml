<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  Extends the original skeleton. Preserved from it: name, format 3, the
  ament_cmake buildtool_depend, the two ament_lint test_depends, and the
  <export><build_type> block. Maintainer kept as the repo owner.
  Version and description filled in; license set to MIT (change if your team
  has agreed on something else - "TODO" makes `colcon build` warn).
-->
<package format="3">
  <name>amr_description</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="sarth010622@todo.todo">sarth010622</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- interface dependencies -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- node dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- the grid loader uses PyYAML; rosdep maps this to the system package -->
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- required for the generated interfaces to be importable at runtime -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- MANDATORY for an interface-generating package. Without this line rosidl
       builds the Python bindings but does not register them, and
       `from amr_description.msg import RobotState` fails with an unhelpful
       ModuleNotFoundError. Most commonly forgotten line in ROS 2. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

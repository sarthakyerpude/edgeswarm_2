<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Cyclone DDS configuration - MULTI-MACHINE over Wi-Fi (three Jetsons).

  WHY MULTICAST IS DISABLED HERE
  Many access points throttle or silently drop multicast, and many enable
  "AP isolation" which blocks client-to-client traffic entirely. DDS uses
  multicast ONLY for participant discovery (SPDP); all data is unicast. So
  turning multicast off and listing peers explicitly restores discovery
  without changing anything about how data flows.

  IS THE PEER LIST A FORM OF CENTRALISATION? No. It is a phone book, not a
  switchboard. It tells participants where to SEND their discovery
  announcements. No listed address has any authority, no data passes through
  one, and removing any entry only affects discovery of that one robot.

  Update the addresses to match your DHCP reservations.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="wlan0" priority="default"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <!-- Keep below the typical 1500-byte MTU path to avoid IP fragmentation,
           which is expensive and lossy on Wi-Fi. -->
      <MaxMessageSize>8192</MaxMessageSize>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer Address="192.168.50.11"/>   <!-- robot_1  -->
        <Peer Address="192.168.50.12"/>   <!-- robot_2  -->
        <Peer Address="192.168.50.13"/>   <!-- robot_3  -->
        <Peer Address="192.168.50.20"/>   <!-- dev laptop / monitor -->
      </Peers>
    </Discovery>

    <Internal>
      <Watermarks>
        <WhcHigh>500kB</WhcHigh>
      </Watermarks>
    </Internal>

    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stdout</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>

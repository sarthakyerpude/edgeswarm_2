// Alternative to rmw_zenoh_cpp: run zenoh-bridge-ros2dds with this config
// beside a DDS-based ROS 2 graph. Do not run both paths for the same graph.
{
  mode: "peer",
  connect: { endpoints: [] },
  listen: { timeout_ms: 0, endpoints: ["tcp/0.0.0.0:7447"] },
  scouting: {
    multicast: {
      enabled: true,
      address: "224.0.0.224:7446",
      interface: "auto",
      autoconnect: { peer: ["peer"] },
    },
    gossip: { enabled: true, multihop: false },
  },
  plugins: {
    ros2dds: {
      nodename: "edgeswarm_zenoh_bridge",
      namespace: "/",
      domain: 42,
      allow: {
        publishers: [
          "^/fleet/(robot_state|intent|zone_request|zone_grant|map_update|task_announce|task_bid|task_award|task_complete|task_release|navigation_status)$",
        ],
        subscribers: [
          "^/fleet/(robot_state|intent|zone_request|zone_grant|map_update|task_announce|task_bid|task_award|task_complete|task_release|navigation_status)$",
        ],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
    },
  },
}

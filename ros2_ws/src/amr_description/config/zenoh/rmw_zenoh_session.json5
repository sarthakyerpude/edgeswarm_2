// Session configuration for rmw_zenoh_cpp in direct peer mode.
// Set ZENOH_SESSION_CONFIG_URI to this file on each robot.
{
  mode: "peer",
  connect: { endpoints: [] },
  listen: { timeout_ms: 0, endpoints: ["tcp/0.0.0.0:7447"] },
  scouting: {
    multicast: {
      enabled: true,
      address: "224.0.0.224:7446",
      interface: "auto",
      autoconnect: { peer: ["peer"] },
    },
    gossip: {
      enabled: true,
      multihop: false,
      target: { peer: ["peer"] },
      autoconnect: { peer: ["peer"] },
    },
  },
  routing: { peer: { mode: "peer_to_peer" } },
}

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="edgeswarm_amr">
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="p" value="$(arg prefix)"/>
  <link name="${p}base_footprint"/>
  <link name="${p}base_link">
    <inertial><origin xyz="0 0 0.06"/><mass value="6.0"/><inertia ixx="0.0584" ixy="0" ixz="0" iyy="0.0872" iyz="0" izz="0.1312"/></inertial>
    <visual><origin xyz="0 0 0.06"/><geometry><box size="0.40 0.32 0.12"/></geometry><material name="blue"><color rgba="0.12 0.4 0.82 1"/></material></visual>
    <collision><origin xyz="0 0 0.06"/><geometry><box size="0.40 0.32 0.12"/></geometry></collision>
  </link>
  <joint name="${p}base_footprint_joint" type="fixed"><parent link="${p}base_footprint"/><child link="${p}base_link"/><origin xyz="0 0 0.05"/></joint>
  <xacro:macro name="wheel" params="side y">
    <link name="${p}wheel_${side}">
      <inertial><mass value="0.3"/><inertia ixx="0.00021" ixy="0" ixz="0" iyy="0.00021" iyz="0" izz="0.000375"/></inertial>
      <visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry><material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material></visual>
      <collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
    </link>
    <joint name="${p}${side}_wheel_joint" type="continuous"><parent link="${p}base_link"/><child link="${p}wheel_${side}"/><origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel side="left" y="0.19"/><xacro:wheel side="right" y="-0.19"/>
  <link name="${p}laser_link"/><joint name="${p}laser_joint" type="fixed"><parent link="${p}base_link"/><child link="${p}laser_link"/><origin xyz="0 0 0.15"/></joint>
  <link name="${p}imu_link"/><joint name="${p}imu_joint" type="fixed"><parent link="${p}base_link"/><child link="${p}imu_link"/><origin xyz="0 0 0.08"/></joint>
</robot>

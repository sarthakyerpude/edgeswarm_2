<!-- Add this sensor element under base_link in model.sdf when integrating the
     Gazebo IMU. Leave <topic> unset so Gazebo derives an entity-specific path. -->
<sensor name="imu" type="imu">
  <pose>0 0 0.02 0 0 0</pose>
  <always_on>true</always_on>
  <update_rate>50</update_rate>
  <imu>
    <angular_velocity>
      <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
      <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
      <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
    </angular_velocity>
    <linear_acceleration>
      <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
      <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
      <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
    </linear_acceleration>
  </imu>
</sensor>

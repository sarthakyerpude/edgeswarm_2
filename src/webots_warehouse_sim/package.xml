<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>webots_warehouse_sim</name>
  <version>0.1.0</version>
  <description>Webots backend for the EdgeSwarm warehouse fleet: world, AMR
    proto and the webots_ros2 driver plugin reproducing the sim topic
    contract (/clock, /robot_N/{odom,scan,tf,cmd_vel}).</description>
  <maintainer email="sarth@example.com">sarth</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>amr_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

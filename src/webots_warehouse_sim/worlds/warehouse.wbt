# ---- items (visual-only: no physics, top below the 0.20 m scan plane while
#      at rest; the item_manager supervisor teleports them onto robots) ------
DEF ITEM_1 Solid {
  translation -3.45 3.85 0.06
  name "item_1"
  children [
    DEF ITEM_SHAPE Shape {
      appearance PBRAppearance { baseColor 0.85 0.3 0.6 roughness 0.6 metalness 0 }
      geometry Box { size 0.14 0.14 0.12 }
    }
  ]
}
DEF ITEM_2 Solid {
  translation 3.45 3.85 0.06
  name "item_2"
  children [ USE ITEM_SHAPE ]
}
DEF ITEM_3 Solid {
  translation -3.45 2.45 0.06
  name "item_3"
  children [ USE ITEM_SHAPE ]
}

# ---- item manager: invisible supervisor that attaches items to the robot
#      the fleet auction awarded the task to (listens on /fleet/*) ----------
DEF ITEM_MANAGER Robot {
  translation 0 0 -0.5
  name "item_manager"
  controller "<extern>"
  supervisor TRUE
}
